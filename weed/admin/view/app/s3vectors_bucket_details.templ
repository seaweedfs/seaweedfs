package app

import (
	"bytes"
	"encoding/json"
	"fmt"
	"strings"

	"github.com/seaweedfs/seaweedfs/weed/admin/dash"
	"github.com/seaweedfs/seaweedfs/weed/s3api/s3vectors"
)

templ S3VectorsBucketDetails(data dash.S3VectorsBucketData) {
	<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
		<div>
			<h1 class="h2 mb-0">
				<i class="bi bi-arrow-up-right me-2"></i>{ data.Bucket.Name }
			</h1>
			<nav aria-label="breadcrumb">
				<ol class="breadcrumb mb-0 mt-1">
					<li class="breadcrumb-item"><a href={ dash.PUrl(ctx, "/object-store/vector-buckets") }>Vector Buckets</a></li>
					<li class="breadcrumb-item active" aria-current="page">{ data.Bucket.Name }</li>
				</ol>
			</nav>
		</div>
	</div>
 @VectorStatus(data.Operations)
 @VectorTools(data.Bucket.Name,data.Bucket.ARN,data.Policy)
	<div class="card shadow mb-4">
		<div class="card-body">
			<dl class="row mb-0">
				<dt class="col-sm-2">ARN</dt>
				<dd class="col-sm-10"><code>{ data.Bucket.ARN }</code></dd>
				<dt class="col-sm-2">Created</dt>
				<dd class="col-sm-10">{ data.Bucket.CreatedAt.Format("2006-01-02 15:04:05") }</dd>
				<dt class="col-sm-2">Encryption</dt>
				<dd class="col-sm-10">
					if data.Bucket.Encryption != "" {
						<span class="badge bg-success">{ data.Bucket.Encryption }</span>
					} else {
						<span class="text-muted">None</span>
					}
				</dd>
			</dl>
		</div>
	</div>
	<div class="card shadow mb-4">
		<div class="card-header py-3">
			<h6 class="m-0 font-weight-bold text-primary">
				<i class="bi bi-list-ul me-2"></i>{ fmt.Sprintf("%d indexes", data.TotalIndexes) }
				if data.Truncated {
					<span class="text-muted small ms-2">{ fmt.Sprintf("showing the first %d; list the rest with an S3 Vectors client", data.TotalIndexes) }</span>
				}
			</h6>
		</div>
		<div class="card-body">
			<div class="table-responsive">
				<table class="table table-hover" width="100%" cellspacing="0" id="s3vectorsIndexesTable">
					<thead>
						<tr>
							<th>Name</th>
							<th>Data Type</th>
							<th>Dimension</th>
							<th>Distance Metric</th>
							<th>Non-filterable Metadata Keys</th>
							<th>Created</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, index := range data.Indexes {
							<tr>
								<td>
									{ index.IndexName }
									<div class="text-muted small">{ index.IndexArn }</div>
								</td>
								<td>{ index.DataType }</td>
								<td>{ fmt.Sprintf("%d", index.Dimension) }</td>
								<td>{ index.DistanceMetric }</td>
								<td>
									if index.MetadataConfiguration != nil && len(index.MetadataConfiguration.NonFilterableMetadataKeys) > 0 {
										<code>{ strings.Join(index.MetadataConfiguration.NonFilterableMetadataKeys, ", ") }</code>
									} else {
										<span class="text-muted">None</span>
									}
								</td>
								<td>{ index.CreationTime.Format("2006-01-02 15:04") }</td>
								<td>
									<button type="button" class="btn btn-outline-danger btn-sm s3vectors-delete-index-btn" data-index-name={ index.IndexName } title="Delete">
										<i class="bi bi-trash"></i>
									</button>
								</td>
							</tr>
						}
						if len(data.Indexes) == 0 {
							<tr>
								<td colspan="7" class="text-center text-muted py-4">
									No indexes. Create one with the form above.
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
	for _, panel := range data.Panels {
		@S3VectorsIndexPanel(panel)
	}
	<div class="card shadow mb-4">
		<div class="card-header py-3">
			<h6 class="m-0 font-weight-bold text-primary">
				<i class="bi bi-shield me-2"></i>Bucket Policy
			</h6>
		</div>
		<div class="card-body">
			if data.Policy != "" {
				<pre class="bg-light p-3 border rounded mb-0" id="s3vectorsBucketPolicy">{ indentJSON(data.Policy) }</pre>
			} else {
				<span class="text-muted">No policy. Set one with <code>PutVectorBucketPolicy</code>.</span>
			}
		</div>
	</div>
	<div class="modal fade" id="deleteS3VectorsIndexModal" tabindex="-1" aria-labelledby="deleteS3VectorsIndexModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="deleteS3VectorsIndexModalLabel">
						<i class="bi bi-exclamation-triangle me-2 text-warning"></i>Delete Index
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<p>Delete the index <strong id="deleteS3VectorsIndexName"></strong> and all its vectors?</p>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
					<button type="button" class="btn btn-danger" id="deleteS3VectorsIndexBtn">
						<i class="bi bi-trash me-1"></i>Delete
					</button>
				</div>
			</div>
		</div>
	</div>
	<div class="modal fade" id="indexS3VectorsMetadataKeyModal" tabindex="-1" aria-labelledby="indexS3VectorsMetadataKeyModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="indexS3VectorsMetadataKeyModalLabel">
						<i class="bi bi-tags me-2"></i>Index a metadata key of <span id="indexS3VectorsMetadataKeyIndex"></span>
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<label for="indexS3VectorsMetadataKeyName" class="form-label">Metadata key</label>
					<input type="text" class="form-control" id="indexS3VectorsMetadataKeyName" autocomplete="off"/>
					<div class="form-text">Filters comparing this key with strings ($eq, $in) read its index instead of every row's metadata. Results do not change.</div>
					<div class="text-danger small mt-2" id="indexS3VectorsMetadataKeyError"></div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
					<button type="button" class="btn btn-primary" id="indexS3VectorsMetadataKeyBtn">
						<i class="bi bi-plus-lg me-1"></i>Index
					</button>
				</div>
			</div>
		</div>
	</div>
	<div class="modal fade" id="removeS3VectorsMetadataKeyModal" tabindex="-1" aria-labelledby="removeS3VectorsMetadataKeyModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="removeS3VectorsMetadataKeyModalLabel">
						<i class="bi bi-exclamation-triangle me-2 text-warning"></i><span id="removeS3VectorsMetadataKeyTitle">Remove Metadata Index</span>
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<p><span id="removeS3VectorsMetadataKeyAction">Remove</span> the index of metadata key <strong id="removeS3VectorsMetadataKeyName"></strong> on index <strong id="removeS3VectorsMetadataKeyIndex"></strong>? Filters on the key read every row's metadata again.</p>
					<div class="text-danger small mt-2" id="removeS3VectorsMetadataKeyError"></div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
					<button type="button" class="btn btn-danger" id="removeS3VectorsMetadataKeyBtn">
						<i class="bi bi-trash me-1"></i><span id="removeS3VectorsMetadataKeyBtnLabel">Remove</span>
					</button>
				</div>
			</div>
		</div>
	</div>
	<div id="s3vectorsBucketDetails" data-bucket-name={ data.Bucket.Name }></div>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const bucket = document.getElementById('s3vectorsBucketDetails').dataset.bucketName;
			const modalEl = document.getElementById('deleteS3VectorsIndexModal');
			const modal = new bootstrap.Modal(modalEl);
			document.querySelectorAll('.s3vectors-delete-index-btn').forEach(button => {
				button.addEventListener('click', function () {
					modalEl.dataset.indexName = this.dataset.indexName || '';
					document.getElementById('deleteS3VectorsIndexName').textContent = this.dataset.indexName || '';
					modal.show();
				});
			});
			async function updateMetadataKey(index, key, remove) {
				const url = remove
					? '/api/s3vectors/metadata-keys?bucket=' + encodeURIComponent(bucket) + '&index=' + encodeURIComponent(index) + '&key=' + encodeURIComponent(key)
					: '/api/s3vectors/metadata-keys';
				const options = { method: remove ? 'DELETE' : 'POST', headers: s3tWriteHeaders() };
				if (!remove) {
					options.headers = Object.assign({ 'Content-Type': 'application/json' }, options.headers);
					options.body = JSON.stringify({ bucket: bucket, index: index, key: key });
				}
				const response = await fetch(s3tBasePath(url), options);
				const data = await response.json();
				if (!response.ok) {
					throw new Error(data.error || 'request failed');
				}
				return data;
			}
			const keyModalEl = document.getElementById('indexS3VectorsMetadataKeyModal');
			const keyModal = new bootstrap.Modal(keyModalEl);
			const keyInput = document.getElementById('indexS3VectorsMetadataKeyName');
			const keyError = document.getElementById('indexS3VectorsMetadataKeyError');
			document.querySelectorAll('.s3vectors-index-key-btn').forEach(button => {
				button.addEventListener('click', function () {
					keyModalEl.dataset.indexName = this.dataset.indexName || '';
					keyModalEl.dataset.nonFilterable = this.dataset.nonFilterable || '[]';
					document.getElementById('indexS3VectorsMetadataKeyIndex').textContent = this.dataset.indexName || '';
					keyInput.value = this.dataset.key || '';
					keyError.textContent = '';
					keyModal.show();
				});
			});
			document.getElementById('indexS3VectorsMetadataKeyBtn').addEventListener('click', async function () {
				const index = keyModalEl.dataset.indexName;
				// Metadata key names are exact strings: only an empty name is refused.
				const key = keyInput.value;
				if (!key.trim()) {
					keyError.textContent = 'Enter a metadata key.';
					return;
				}
				if (JSON.parse(keyModalEl.dataset.nonFilterable || '[]').includes(key)) {
					keyError.textContent = key + ' is a non-filterable key of this index and cannot be indexed.';
					return;
				}
				try {
					await updateMetadataKey(index, key, false);
					location.reload();
				} catch (error) {
					keyError.textContent = error.message;
				}
			});
			const removeModalEl = document.getElementById('removeS3VectorsMetadataKeyModal');
			const removeModal = new bootstrap.Modal(removeModalEl);
			const removeError = document.getElementById('removeS3VectorsMetadataKeyError');
			document.querySelectorAll('.s3vectors-remove-key-btn').forEach(button => {
				button.addEventListener('click', function () {
					const action = this.dataset.action || 'Remove';
					removeModalEl.dataset.indexName = this.dataset.indexName || '';
					removeModalEl.dataset.key = this.dataset.key || '';
					document.getElementById('removeS3VectorsMetadataKeyTitle').textContent = action + ' Metadata Index';
					document.getElementById('removeS3VectorsMetadataKeyAction').textContent = action;
					document.getElementById('removeS3VectorsMetadataKeyBtnLabel').textContent = action;
					document.getElementById('removeS3VectorsMetadataKeyName').textContent = this.dataset.key || '';
					document.getElementById('removeS3VectorsMetadataKeyIndex').textContent = this.dataset.indexName || '';
					removeError.textContent = '';
					removeModal.show();
				});
			});
			document.getElementById('removeS3VectorsMetadataKeyBtn').addEventListener('click', async function () {
				const index = removeModalEl.dataset.indexName;
				const key = removeModalEl.dataset.key;
				if (!index || !key) return;
				try {
					await updateMetadataKey(index, key, true);
					location.reload();
				} catch (error) {
					removeError.textContent = error.message;
				}
			});
			document.getElementById('deleteS3VectorsIndexBtn').addEventListener('click', async function () {
				const index = modalEl.dataset.indexName;
				if (!bucket || !index) return;
				try {
					const response = await fetch(s3tBasePath('/api/s3vectors/indexes?bucket=' + encodeURIComponent(bucket) + '&index=' + encodeURIComponent(index)), { method: 'DELETE', headers: s3tWriteHeaders() });
					const data = await response.json();
					if (!response.ok) {
						alert(data.error || 'Failed to delete index');
						return;
					}
					location.reload();
				} catch (error) {
					alert('Failed to delete index: ' + error.message);
				}
			});
		});
	</script>
}

templ S3VectorsIndexPanel(panel dash.S3VectorsIndexPanel) {
	<div class="card shadow mb-4 s3vectors-index-panel" data-index-name={ panel.Index.IndexName }>
		<div class="card-header py-3">
			<h6 class="m-0 font-weight-bold text-primary">
				<i class="bi bi-diagram-3 me-2"></i>Index: { panel.Index.IndexName }
			</h6>
			<div class="small text-muted mt-1">
				{ fmt.Sprintf("Dimension %d", panel.Index.Dimension) } · { panel.Index.DistanceMetric } · { groupDigits(float64(panel.Vectors)) } vectors · Vector index:
				if panel.VectorIndex != "" {
					{ panel.VectorIndex }
				} else {
					none (exact scan)
				}
			</div>
		</div>
		<div class="card-body">
			if panel.Error != "" {
				<div class="alert alert-warning py-2 small">{ panel.Error }</div>
			}
			<div class="d-flex justify-content-between align-items-center mb-2">
				<strong>Metadata indexes</strong>
				<button type="button" class="btn btn-outline-primary btn-sm s3vectors-index-key-btn" data-index-name={ panel.Index.IndexName } data-non-filterable={ nonFilterableJSON(panel.Index) }>
					<i class="bi bi-plus-lg me-1"></i>Index a key
				</button>
			</div>
			<div class="table-responsive">
				<table class="table table-sm table-hover mb-3">
					<thead>
						<tr>
							<th>Key</th>
							<th>State</th>
							<th>Coverage</th>
							<th>Filtered queries/h</th>
							<th>Size</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, key := range panel.Keys {
							<tr>
								<td><code>{ key.Key }</code></td>
								<td>{ keyState(key.State) }</td>
								<td>
									if key.State == "requested" {
										—
									} else {
										{ fmt.Sprintf("%.0f%%", key.Coverage) }
									}
								</td>
								<td>{ groupDigits(key.QueriesPerHour) }</td>
								<td>
									if key.IndexBytes > 0 {
										{ fmt.Sprintf("%.1f MiB", float64(key.IndexBytes)/(1<<20)) }
									} else {
										—
									}
								</td>
								<td>
									if key.State == "ready" {
										<button type="button" class="btn btn-link btn-sm p-0 text-danger s3vectors-remove-key-btn" data-index-name={ panel.Index.IndexName } data-key={ key.Key } data-action="Remove">Remove</button>
									} else if key.State == "requested" || key.State == "building" {
										<button type="button" class="btn btn-link btn-sm p-0 s3vectors-remove-key-btn" data-index-name={ panel.Index.IndexName } data-key={ key.Key } data-action="Cancel">Cancel</button>
									}
								</td>
							</tr>
						}
						if len(panel.Keys) == 0 {
							<tr>
								<td colspan="6" class="text-center text-muted">No indexed metadata keys.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<strong>Frequently filtered, not indexed</strong>
			if panel.StatsError != "" {
				<div class="text-muted small">{ panel.StatsError }</div>
			}
			if panel.StatsTruncated {
				<div class="text-muted small">Partial: an engine counts a limited number of keys per index, so some filtered keys are missing.</div>
			}
			if len(panel.Frequent) == 0 {
				<div class="text-muted small mt-1">No filtered queries in the last hour on keys without an index.</div>
			}
			<ul class="list-unstyled mt-1 mb-0">
				for _, key := range panel.Frequent {
					<li class="d-flex align-items-center py-1">
						<code class="me-3">{ key.Key }</code>
						<span class="me-3">{ groupDigits(key.QueriesPerHour) } queries/h</span>
						<span class="me-3 text-muted">{ fmt.Sprintf("avg %.0f ms", key.AvgMs) }</span>
						if key.Numeric {
							<span class="text-muted small">(numeric: phase 2)</span>
						} else {
							<button type="button" class="btn btn-outline-primary btn-sm ms-auto s3vectors-index-key-btn" data-index-name={ panel.Index.IndexName } data-key={ key.Key } data-non-filterable={ nonFilterableJSON(panel.Index) }>Index</button>
						}
					</li>
				}
			</ul>
		</div>
	</div>
}

func keyState(state string) string {
	switch state {
	case "requested":
		return "Requested"
	case "building":
		return "Building"
	case "ready":
		return "Ready"
	case "off":
		return "Removing"
	}
	return state
}

// groupDigits renders n rounded, with thousands separators.
func groupDigits(n float64) string {
	digits := fmt.Sprintf("%.0f", n)
	var out []byte
	for i := range digits {
		if i > 0 && (len(digits)-i)%3 == 0 {
			out = append(out, ',')
		}
		out = append(out, digits[i])
	}
	return string(out)
}

func nonFilterableJSON(index *s3vectors.Index) string {
	keys := []string{}
	if index.MetadataConfiguration != nil && index.MetadataConfiguration.NonFilterableMetadataKeys != nil {
		keys = index.MetadataConfiguration.NonFilterableMetadataKeys
	}
	b, _ := json.Marshal(keys)
	return string(b)
}

const maxIndentedJSONDepth = 32

func indentJSON(s string) string {
	if jsonDepth(s) > maxIndentedJSONDepth {
		return s
	}
	var out bytes.Buffer
	if json.Indent(&out, []byte(s), "", "  ") != nil {
		return s
	}
	return out.String()
}

func jsonDepth(s string) int {
	depth, maxDepth := 0, 0
	inString, escaped := false, false
	for i := 0; i < len(s); i++ {
		c := s[i]
		switch {
		case escaped:
			escaped = false
		case inString:
			if c == '\\' {
				escaped = true
			} else if c == '"' {
				inString = false
			}
		case c == '"':
			inString = true
		case c == '{' || c == '[':
			depth++
			if depth > maxDepth {
				maxDepth = depth
			}
		case c == '}' || c == ']':
			depth--
		}
	}
	return maxDepth
}
